# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# TMDB API key (v3 auth) — https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Ollama instance base URL (default: local Docker service)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model used for structured extraction
OLLAMA_MODEL=llama3.2

# SQLite database file path
DATABASE_URL=sqlite+aiosqlite:///./lanterne.db

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Telegram chat id that receives the post-scrape admin report (optional).
# Leave empty to disable; get yours by messaging @userinfobot.
ADMIN_CHAT_ID=

# paris-cine.info account (optional) — enables the Paris Ciné Info source,
# see docs/decisions/0007-paris-cine-info.md. Leave both empty to skip it.
PARIS_CINE_INFO_LOGIN=
PARIS_CINE_INFO_PASSWORD=
