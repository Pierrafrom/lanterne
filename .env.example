# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# TMDB API key (v3 auth) — https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Ollama instance base URL. Only used when running the CLI directly on the
# host — docker-compose.yml overrides this to http://ollama:11434 for the
# bot/scraper containers, so it doesn't need editing for `docker compose up`.
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model used for structured extraction — see docs/setup.md's
# "Choosing a model" for why qwen2.5 is recommended over llama3.2/mistral.
OLLAMA_MODEL=qwen2.5:7b

# PostgreSQL connection URL (async, asyncpg driver). Only used when running
# the CLI directly on the host — docker-compose.yml overrides this to point
# at the postgres service for the bot/scraper containers.
DATABASE_URL=postgresql+asyncpg://lanterne:lanterne@localhost:5432/lanterne

# PostgreSQL credentials for the docker-compose `postgres` service itself
# (dev-only defaults below; override for anything beyond local dev).
POSTGRES_USER=lanterne
POSTGRES_PASSWORD=lanterne
POSTGRES_DB=lanterne

# Host-side ports docker-compose.yml publishes postgres/ollama on — default
# to non-standard values (5433/11435) so they don't collide with a
# locally-run Postgres or Ollama instance. Only affects host access (psql,
# curl); containers reach each other on the standard ports regardless.
POSTGRES_HOST_PORT=5433
OLLAMA_HOST_PORT=11435
PGWEB_HOST_PORT=8082
API_HOST_PORT=8001
WEB_HOST_PORT=3000

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Telegram chat id that receives the post-scrape admin report (optional).
# Leave empty to disable; get yours by messaging @userinfobot.
ADMIN_CHAT_ID=

# paris-cine.info account (optional) — enables the Paris Ciné Info source,
# see docs/decisions/0007-paris-cine-info.md. Leave both empty to skip it.
PARIS_CINE_INFO_LOGIN=
PARIS_CINE_INFO_PASSWORD=
